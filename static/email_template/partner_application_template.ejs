<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="x-apple-disable-message-reformatting" />
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8" />
    <title></title>
    <style type="text/css" rel="stylesheet" media="all">
      body {
        width: 100% !important;
        height: 100%;
        margin: 0;
        -webkit-text-size-adjust: none;
      }
      a {
        color: #3869d4;
      }
      a img {
        border: none;
      }
      td {
        word-break: break-word;
      }
      body,
      td,
      th {
        font-family: "Nunito Sans", Helvetica, Arial, sans-serif;
      }
      p,
      ul,
      ol,
      blockquote {
        margin: 0.4em 0 1.1875em;
        font-size: 16px;
        line-height: 1.625;
      }
    </style>
  </head>
  <body style="margin: 0; padding: 0; background-color: #f4f6f8;">
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      role="presentation"
      style="background-color: #f4f6f8; padding: 20px 0;"
    >
      <tr>
        <td align="center">
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            role="presentation"
            style="max-width: 600px; background-color: #ffffff;"
          >
            <tr>
              <td style="padding: 25px;">
                <div
                  style="
                    font-family: Arial, Helvetica, sans-serif;
                    font-size: 14px;
                    color: #333333;
                    line-height: 1.6;
                  "
                >
                  <h2
                    style="
                      margin: 0 0 20px 0;
                      font-size: 16px;
                      font-weight: 600;
                    "
                  >
                    New Partner Application – IEEUK
                  </h2>
                  <p style="margin: 0 0 20px 0;">
                    A new partner application has been submitted through the
                    IEEUK "Become a Partner" form.
                  </p>
                  <table
                    width="100%"
                    cellpadding="0"
                    cellspacing="0"
                    role="presentation"
                    style="border-collapse: collapse;"
                  >
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600; width: 40%;">
                        Organisation Name
                      </td>
                      <td style="padding: 6px 0;"><%= organisationName %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Organisation Type
                      </td>
                      <td style="padding: 6px 0;"><%= organisationType %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">Website</td>
                      <td style="padding: 6px 0;"><%= website %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">Country</td>
                      <td style="padding: 6px 0;"><%= country %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">City</td>
                      <td style="padding: 6px 0;"><%= city %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Contact Person
                      </td>
                      <td style="padding: 6px 0;"><%= contactPerson %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Email Address
                      </td>
                      <td style="padding: 6px 0;"><%= email %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Phone / WhatsApp
                      </td>
                      <td style="padding: 6px 0;"><%= phone %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Countries You Recruit From
                      </td>
                      <td style="padding: 6px 0;"><%= countriesRecruit %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Approximate Students Recruited Annually
                      </td>
                      <td style="padding: 6px 0;"><%= annualStudents %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600;">
                        Universities Currently Represented
                      </td>
                      <td style="padding: 6px 0;"><%= universities %></td>
                    </tr>
                    <tr>
                      <td style="padding: 6px 0; font-weight: 600; vertical-align: top;">
                        Message
                      </td>
                      <td style="padding: 6px 0;"><%= message %></td>
                    </tr>
                  </table>
                  <p style="margin-top: 20px;">
                    Please review the above information and proceed with the
                    appropriate follow-up.
                  </p>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>